# ============================================================
# Contoh konfigurasi Dashboard Konten AI (Fase 0)
# Cara pakai: cp .env.example .env  (lalu ubah nilai yang ditandai GANTI)
# Bahasa: semua komentar dalam Bahasa Indonesia.
# ============================================================

# ---------- Database Postgres ----------
POSTGRES_USER=postgres
# GANTI_DENGAN_RAHASIA: gunakan string acak yang kuat (min. 32 karakter).
POSTGRES_PASSWORD=GANTI_DENGAN_RAHASIA
POSTGRES_DB=dashboard

# User database khusus aplikasi (least privilege), dibuat otomatis oleh
# entrypoint.sh milik backend saat pertama kali berjalan.
APP_DB_USER=app_user
APP_DB_PASSWORD=GANTI_DENGAN_RAHASIA

# URL koneksi yang dipakai API. Variabel berikut ini (bukan nilai mentahnya)
# yang diteruskan ke container api di docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://app_user:GANTI_DENGAN_RAHASIA@db:5432/dashboard
SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:GANTI_DENGAN_RAHASIA@db:5432/dashboard
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:GANTI_DENGAN_RAHASIA@db:5432/dashboard

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Keamanan JWT ----------
JWT_ALGORITHM=HS256
# WAJIB DIGANTI DI PRODUKSI: gunakan string acak panjang (min. 64 karakter).
JWT_SECRET_KEY=GANTI_DENGAN_RAHASIA
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Lingkungan & batas bisnis (configurable) ----------
# dev | prod — di prod matikan endpoint /dev dan fitur debug.
ENV=dev
# Batas jumlah brand per organisasi (configurable, tanpa deploy ulang cukup restart).
MAX_BRANDS_PER_ORG=3
# Masa tenggang setelah membership kedaluwarsa sebelum akses dibatasi (hari).
GRACE_PERIOD_DAYS=7
# Durasi default satu paket membership (hari).
MEMBERSHIP_DURATION_DAYS=365
# Berapa lama invoice pembayaran manual dianggap valid sebelum kedaluwarsa (jam).
INVOICE_EXPIRY_HOURS=24

# ---------- Rekening tujuan transfer manual ----------
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=PT Dashboard Konten AI

# ---------- Storage (bukti transfer) ----------
STORAGE_DIR=./storage

# ---------- Seed admin (hanya dipakai perintah seed di dev) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- SMTP (opsional, disiapkan untuk fase berikutnya) ----------
# Kosongkan bila belum dipakai; backend men-skip pengiriman email jika tidak diisi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dashboard.local

# ---------- LLM (diteruskan ke container api; lihat apps/api/.env.example) ----------
# Pilihan: mock (default, tanpa biaya), openai, anthropic
LLM_PROVIDER=mock
# GANTI_DENGAN_RAHASIA bila memakai provider berbayar. JANGAN commit key asli.
LLM_API_KEY=
LLM_MODEL=

# ---------- Worker Fase 2 (penjadwal; service `worker` di docker-compose) ----------
# Interval sinkronisasi ConnectedAccount (jam).
SYNC_INTERVAL_HOURS=6
# Jadwal ringkasan mingguan format crontab: tiap Senin 07:00.
SUMMARY_CRON=0 7 * * 1
# Zona waktu penjadwalan worker.
WORKER_TIMEZONE=Asia/Jakarta

# ---------- Fase 2: enkripsi, URL publik, OAuth (diteruskan ke container api) ----------
# Lihat apps/api/.env.example untuk penjelasan tiap variabel.
FERNET_KEY=<redacted>
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
