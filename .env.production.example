# Contoh environment production — Dashboard Konten AI
# Salin ke dashboard Render (Environment) / Vercel (Environment Variables).
# JANGAN commit file berisi nilai asli ke git.

# --- Wajib: database (Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# --- Wajib: keamanan (generate baru, jangan pakai default dev!) ---
# JWT: openssl rand -hex 32
JWT_SECRET_KEY=
# Fernet: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Wajib: URL publik ---
ENV=prod
FRONTEND_URL=https://dkai-web.vercel.app
API_BASE_URL=https://dkai-api.onrender.com
CORS_ORIGINS=https://dkai-web.vercel.app

# --- Frontend (Vercel): hanya ini yang dibutuhkan ---
NEXT_PUBLIC_API_URL=https://dkai-api.onrender.com

# --- Bisnis (opsional, ada default) ---
MAX_BRANDS_PER_ORG=3
MAX_ACCOUNTS_PER_PLATFORM=3
GRACE_PERIOD_DAYS=7
MEMBERSHIP_DURATION_DAYS=365
INVOICE_EXPIRY_HOURS=24

# --- Rekening transfer manual (tampilkan di invoice) ---
BANK_NAME=Bank Central Asia (BCA)
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# --- Worker (opsional, ada default) ---
SYNC_INTERVAL_HOURS=6
SUMMARY_CRON=0 7 * * 1
WORKER_TIMEZONE=Asia/Jakarta
