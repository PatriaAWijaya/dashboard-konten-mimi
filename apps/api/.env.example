# URL koneksi database untuk aplikasi (role non-superuser, async)
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/dashboard_konten
# URL superuser untuk entrypoint (buat role + grant)
SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dashboard_konten
# URL migrasi (default: pakai SUPERUSER_DATABASE_URL)
MIGRATION_DATABASE_URL=
# Kredensial role aplikasi (dibuat oleh entrypoint.sh bila belum ada)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password_kuat

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# dev | staging | prod  (endpoint /dev/* hanya aktif saat ENV=dev)
ENV=dev

# Batasan bisnis
MAX_BRANDS_PER_ORG=3
GRACE_PERIOD_DAYS=7
MEMBERSHIP_DURATION_DAYS=365
INVOICE_EXPIRY_HOURS=24

# Rekening tujuan transfer manual
BANK_NAME=Bank Central Asia (BCA)
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=PT Dashboard Konten AI

# Penyimpanan file bukti pembayaran
STORAGE_DIR=./storage

# Akun superadmin awal (dibuat oleh python -m app.seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# SMTP (dipakai SmtpEmailService saat ENV bukan dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@dashboard.local
SMTP_USE_TLS=true

# Brevo HTTP API (pengiriman via port 443; dipakai bila diisi,
# untuk hosting yang memblokir outbound SMTP seperti Render free tier).
# Buat di Brevo: SMTP SMTP_USE_TLS=true API -> API Keys. Format: xkeysib-...
BREVO_API_KEY=

# ---------- LLM (narasi agregat; tidak pernah menerima data mentah) ----------
# Pilihan: mock (default, tanpa biaya), openai, anthropic
LLM_PROVIDER=mock
# Isi hanya bila LLM_PROVIDER=openai/anthropic. JANGAN commit key asli.
LLM_API_KEY=
# Model yang dipakai provider (contoh: gpt-4o-mini / claude-3-5-haiku-latest)
LLM_MODEL=

# ---------- Fase 2: enkripsi, URL publik, OAuth ----------
# Kunci Fernet (base64 32 byte). WAJIB diisi di prod; kosong = kunci sementara
# per proses (token terenkripsi tidak bisa dibaca setelah restart).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<redacted>
# URL publik frontend (untuk redirect setelah OAuth callback)
FRONTEND_URL=http://localhost:3000
# URL publik API (untuk redirect_uri OAuth; harus sama dengan yang didaftarkan di TikTok/Meta)
API_BASE_URL=http://localhost:8000

# Kredensial OAuth (fallback dev). Cara resmi: superadmin mengisi via
# PUT /admin/pengaturan (tersimpan terenkripsi di app_settings).
# Tanpa kredensial lengkap: endpoint OAuth mengembalikan 501, sync memakai data demo.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Notifikasi WhatsApp (provider: mock/fonnte). Cara resmi: /admin/pengaturan.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
